modules = ["nodejs-22", "bash"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && EXPO_PUBLIC_PREVIEW_DEMO=true yarn expo start --web --port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Expo Go (tunnel)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && EXPO_PUBLIC_PREVIEW_DEMO=true yarn expo start --go --tunnel --clear --port 5000"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[userenv]

[userenv.shared]
EXPO_PUBLIC_ENABLE_DEMO_LOGIN = "false"
EXPO_PUBLIC_PREVIEW_DEMO = "false"
EXPO_PUBLIC_BACKEND_URL = "https://dashboard.exzibo.online"

[deployment]
deploymentTarget = "cloudrun"
