{
  "expo": {
    "name": "Exzibo Manager",
    "slug": "exzibo-manager",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "exzibo-manager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "online.exzibo.manager"
    },
    "android": {
      "package": "online.exzibo.manager"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b83e1161-1f19-4391-becc-dd1e87b9e7f9"
      }
    },
    "owner": "app-manager-07s-team"
  }
}
